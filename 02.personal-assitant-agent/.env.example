# ── 02.personal-assitant-agent/.env.example ─────────────────────────────
# 이 파일을 복사해 .env 로 만들고 값을 채우세요:
#   cp .env.example .env

# 로컬 PostgreSQL (프로젝트 1과 동일 호스트/포트, DB 이름만 분리)
# 먼저 DB를 만들어야 합니다:  CREATE DATABASE assistant_db;
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/assistant_db

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID(웹)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# 아래 값을 구글 콘솔의 "승인된 리디렉션 URI"에 그대로 등록해야 합니다.
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# refresh_token 암호화 키 (Fernet)
#   생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key

# 세션 서명 키
#   생성: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-random-hex
